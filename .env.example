# Copy this file to ".env" in the project root, then edit it.
# `docker compose` reads ".env" automatically. NEVER commit .env (it is in .gitignore).

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=cybermitra
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cybermitra

# --- Backend ------------------------------------------------------------------
# Your public address(es). Comma-separated, no trailing slash.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Unlocks every stored complaint draft - treat it like a root password.
# 20+ random characters are REQUIRED (the backend refuses to start in production with a weak one).
# Generate one with:   openssl rand -hex 32
ADMIN_API_KEY=

# Per-visitor request limit applied to every endpoint (some endpoints have stricter ones)
RATE_LIMIT_DEFAULT=60/minute

# Privacy: complaint drafts and contact messages older than this are deleted automatically.
# 365 days = the "12 months" promised in the Privacy Policy (frontend/legal.config.json: draftRetentionMonths).
# Change both together. 0 disables automatic deletion.
COMPLAINT_RETENTION_DAYS=365
