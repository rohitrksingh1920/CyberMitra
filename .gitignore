
# ==========================================
# CyberMitra - Root .gitignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.example.*
!.env.sample
!.env.template

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/

# Node.js and package managers
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Local databases
*.db
*.sqlite
*.sqlite3

# Database backups and exports
*.dump
*.backup
*.bak
*.sql.gz
*.dump.gz

# IMPORTANT:
# Do not ignore *.sql
# Database migrations must be committed.

# Docker local overrides
docker-compose.override.yml
compose.override.yaml
docker-compose.local.yml

# Local certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Temporary files
*.tmp
*.temp
*.orig
*.rej

# Local certificates / Certbot data
deploy/certbot-data/conf/live/
deploy/certbot-data/conf/archive/
deploy/certbot-data/conf/accounts/
deploy/certbot-data/conf/renewal/

# Runtime data
logs/
tmp/
temp/
uploads/
storage/
media_uploads/

# Docker persistent data
**/postgres_data/
**/redis_data/
**/minio_data/

# Local recordings
Recording*.mp4

# Local database backup files
cybermitra-before-report-fix.sql
cybermitra-production-check.dump